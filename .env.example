# HydroRivers — exemplo de variáveis (valores fictícios; não use em produção).
# Copie para `.env.local` na sua máquina. Não commite segredos reais.
# Detalhes: docs/ENVIRONMENT.md

# -----------------------------------------------------------------------------
# Convenção de ambiente lógico (documentação / plano — runtime pode ignorar até haver wiring)
# Valores sugeridos: development | test | demo | production
# -----------------------------------------------------------------------------
HYDRORIVERS_APP_ENV=development

# -----------------------------------------------------------------------------
# Auth mock — OTP (USADO em produção de código: src/app/api/auth/login/route.ts)
# "true" devolve o código OTP no JSON — somente para E2E ou demo controlada.
# Em produção real: false ou não definir.
# -----------------------------------------------------------------------------
HYDRORIVERS_EXPOSE_OTP_CODE=false

# -----------------------------------------------------------------------------
# URL pública da aplicação (planejada para links/absolutos; MVP pode não consumir)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Mock-mode / cenários (PLANO — não lido pelo código nesta baseline)
# Quando implementado, deve bloquear reset de cenário em production.
# -----------------------------------------------------------------------------
HYDRORIVERS_ALLOW_MOCK_MODE_RESET=true

# -----------------------------------------------------------------------------
# Futuro: persistência e serviços externos (não utilizados pelo MVP mock atual)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://hydro:fake_local_password@127.0.0.1:5432/hydrorivers_demo
BLOB_READ_WRITE_TOKEN=fake_blob_rw_token_replace_me
SUPABASE_URL=https://fake-project.supabase.co
SUPABASE_ANON_KEY=fake_supabase_anon_key_replace_me

# -----------------------------------------------------------------------------
# Futuro: segredo de sessão/JWT (não usado pelo auth mock atual)
# -----------------------------------------------------------------------------
AUTH_SECRET=fake_dev_secret_min_32_chars________________
